{
  "name": "bedrock-protocol-tests",
  "private": true,
  "description": "Validates bedrock-protocol + minecraft-data against packets every Bedrock Dedicated Server build writes and reads itself",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "postinstall": "node src/checkouts/setup.ts",
    "servers": "node --env-file-if-exists=.env src/servers/main.ts",
    "capture": "node --env-file-if-exists=.env src/capture/main.ts",
    "build:native": "xmake -y",
    "export": "xmake -y -q && build\\windows\\x64\\release\\bpx_launch.exe",
    "protocol": "node src/checkouts/protocol.ts",
    "validate": "node --env-file-if-exists=.env src/validator/main.ts",
    "all": "pnpm servers && pnpm capture && pnpm export && pnpm validate",
    "typecheck": "tsc"
  },
  "dependencies": {
    "bedrock-protocol": "link:./checkouts/bedrock-protocol",
    "minecraft-data": "link:./checkouts/node-minecraft-data",
    "minecraft-bedrock-server": "1.5.2",
    "debug": "^4.3.1",
    "jsonwebtoken": "^9.0.0",
    "jsp-raknet": "^2.1.3",
    "minecraft-folder-path": "^1.2.0",
    "prismarine-auth": "^3.0.0",
    "prismarine-nbt": "^2.8.0",
    "prismarine-realms": "^1.6.0",
    "protodef": "^1.19.0",
    "raknet-native": "^1.0.3",
    "uuid-1345": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "protodef-yaml": "^1.5.7",
    "typescript": "^5.9.3"
  }
}
