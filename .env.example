# Copy to .env to override. Relative paths are the repo's.

# <SERVERS_DIR>/<version>/bedrock_server.exe; point at existing servers to reuse them
SERVERS_DIR=./servers

OUT_DIR=./out

# each build gets an IPv4 and an IPv6 port, in versions.json order
SERVER_PORT_BASE=41032

# servers run in parallel by pnpm capture and pnpm export
JOBS=4
