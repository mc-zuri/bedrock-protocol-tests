# Copy to .env (git ignored) to change any of these. Relative paths are the repo's.

# The servers, one directory per build: <SERVERS_DIR>/<mcDataVersion>/bedrock_server.exe.
# `pnpm servers` downloads the missing ones; point this at existing ones to reuse them.
SERVERS_DIR=./servers

# Everything generated, by version: <OUT_DIR>/<version>/captured-packets.bin (pnpm capture),
# generated-packets.bin (pnpm export), report.json (pnpm validate)
OUT_DIR=./out

# First server port; each build gets an IPv4 and an IPv6 port, in versions.json order
SERVER_PORT_BASE=41032

# Servers run at the same time by pnpm capture and pnpm export
JOBS=4
